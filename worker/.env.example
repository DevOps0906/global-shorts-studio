# 워커 환경 변수(이름만). 실제 값은 Railway 변수에만 넣는다. 저장소·로그에 값 금지.
# Postgres 직접 연결(pgmq 소비·definer 함수 실행). Supabase 세션 풀러 또는 직접 연결 문자열.
DATABASE_URL=
# Storage REST(원본 내려받기·프록시 올리기)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Claude API(공식 SDK가 읽는다)
ANTHROPIC_API_KEY=
# 모델·설정(설정값으로만, 코드 하드코딩 금지). 예: claude-sonnet-5-5
LLM_MODEL=
# 선택: 서버 측 fallback(기본 true) · effort(기본 medium) · Whisper 모델(기본 small)
LLM_FALLBACK=
LLM_EFFORT=
WHISPER_MODEL=
